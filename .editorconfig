root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.ui]
indent_style = space
indent_size = 2
max_line_length = 100000

[*.qml]
indent_style = space
indent_size = 2
max_line_length = 100000

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.sh]
end_of_line = lf

[*.bat]
end_of_line = crlf
